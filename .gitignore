# ============================================================================
#  本文件必须存成「无 BOM 的 UTF-8」。
#  有 BOM 的话，BOM 三个字节会粘在第一行的 # 前面，
#  git 就不会把第一行当注释，而是拿 "\ufeff# ..." 去当匹配规则 —— 很难查。
# ============================================================================

# ---- Gradle 本地状态与缓存 -------------------------------------------------
.gradle/
# 本项目把 GRADLE_USER_HOME 指到了项目内，好处是缓存跟着项目走、不污染全局。
# 代价是 570 MB，绝对不能进版本库。
.gradle-home/

# ---- 构建产物 --------------------------------------------------------------
build/
# Fabric Loom 起的开发用运行目录
run/
out/
bin/
*.class

# ---- 本地测试服 ------------------------------------------------------------
# 排除原因不是"能忽略就忽略"，而是**必须排除**：
#   1. 里面是 Mojang 的 server.jar（58 MB）和一堆依赖库 —— 不能再分发
#   2. 里面是 testworld 世界存档、ops.json、usercache.json —— 含玩家 UUID
# 3. 体积 142 MB，且每次跑都变，没有进版本库的价值
# 新克隆的仓库自己搭一次即可，run-testserver.ps1 会在缺文件时明确告诉你怎么搭。
testserver/

# ---- 运行期生成的配置 ------------------------------------------------------
# 服务端首次启动会在运行目录下生成 config/mcoo/*.json。
# 那是**本机实例的配置**，不是模板；模板应该另写 config/mcoo.example/。
config/mcoo/

# ---- 仅供本机开发的过程文档（不对外）------------------------------------
# 这些是开发过程中的约束和记录：怎么写代码、里程碑怎么排、
# 每轮测试结果、指令表里那些自检流程。
# 外人用不到，也不想看 —— 但它们是这个项目的工程记录，
# 所以**留在磁盘上**，只是不进版本库。
# 哪天需要公开（比如招协作者），从 .gitignore 里删掉这几行再提交即可。
/AGENTS.md
/SAFETY.md
/PLAN.md
/CHANGE.md
/COMMANDS.md

# ---- 日志 ------------------------------------------------------------------
logs/
*.log
*.log.gz

# ---- IDE -------------------------------------------------------------------
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.classpath
.project
nbproject/

# ---- 操作系统 --------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini

# ---- 杂项 ------------------------------------------------------------------
# 根目录散落的 jar（比如临时下载的 Mojang 包）不进版本库。
# 用 / 限定在根目录，避免误伤 gradle/wrapper/gradle-wrapper.jar ——
# **wrapper 的 jar 必须入库**，否则别人 clone 下来构建不了。
/*.jar